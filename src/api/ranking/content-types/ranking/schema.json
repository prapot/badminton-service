{
  "kind": "collectionType",
  "collectionName": "rankings",
  "info": {
    "singularName": "ranking",
    "pluralName": "rankings",
    "displayName": "ranking"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user_id": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "rankings"
    },
    "season": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::season.season",
      "inversedBy": "rankings"
    },
    "match_played": {
      "type": "integer",
      "default": 0
    },
    "win": {
      "type": "integer",
      "default": 0
    },
    "lose": {
      "type": "integer",
      "default": 0
    },
    "point_for": {
      "type": "integer",
      "default": 0
    },
    "point_against": {
      "type": "integer",
      "default": 0
    },
    "win_streak": {
      "type": "integer",
      "default": 0
    },
    "ranking_points": {
      "type": "integer",
      "default": 0
    },
    "rank": {
      "type": "string",
      "default": "Gold III"
    },
    "stars": {
      "type": "integer",
      "default": 2
    },
    "brave_points": {
      "type": "integer",
      "default": 0
    },
    "rank_tier": {
      "type": "string"
    },
    "rank_division": {
      "type": "integer"
    },
    "match_histories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::match-history.match-history",
      "mappedBy": "ranking"
    }
  }
}