{
  "kind": "collectionType",
  "collectionName": "tournaments",
  "info": {
    "singularName": "tournament",
    "pluralName": "tournaments",
    "displayName": "tournament"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "single",
        "double"
      ]
    },
    "format": {
      "type": "enumeration",
      "enum": [
        "round_robin",
        "knockout",
        "americano"
      ]
    },
    "tournament_status": {
      "type": "enumeration",
      "enum": [
        "upcoming",
        "ongoing",
        "completed"
      ]
    },
    "tournament_players": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tournament-player.tournament-player",
      "mappedBy": "tournament_id"
    },
    "teams": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::team.team",
      "mappedBy": "tournament_id"
    },
    "matches": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::match.match",
      "mappedBy": "tournament_id"
    },
    "startDate": {
      "type": "date"
    },
    "mode": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "casual",
        "ranking"
      ]
    },
    "user_created": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "tournaments"
    }
  }
}
