{
  "kind": "collectionType",
  "collectionName": "tournament_players",
  "info": {
    "singularName": "tournament-player",
    "pluralName": "tournament-players",
    "displayName": "Tournament Player"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "tournament_id": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tournament.tournament",
      "inversedBy": "tournament_players"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "tournament_players"
    },
    "seed": {
      "type": "integer"
    },
    "is_paused": {
      "type": "boolean",
      "default": false
    },
    "match_offset": {
      "type": "integer",
      "default": 0
    },
    "guest_name": {
      "type": "string"
    }
  }
}
