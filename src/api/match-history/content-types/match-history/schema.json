{
  "kind": "collectionType",
  "collectionName": "match_histories",
  "info": {
    "singularName": "match-history",
    "pluralName": "match-histories",
    "displayName": "match_history"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "users": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "inversedBy": "match_histories"
    },
    "matches": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::match.match",
      "inversedBy": "match_histories"
    },
    "old_rp": {
      "type": "integer",
      "default": 0
    },
    "new_rp": {
      "type": "integer",
      "default": 0
    },
    "rp_change": {
      "type": "integer",
      "default": 0
    },
    "ranking": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::ranking.ranking",
      "inversedBy": "match_histories"
    },
    "is_win": {
      "type": "boolean",
      "default": false
    }
  }
}