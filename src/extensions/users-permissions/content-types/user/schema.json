{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "team_players": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::team-player.team-player",
      "mappedBy": "user_id"
    },
    "rankings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ranking.ranking",
      "mappedBy": "user_id"
    },
    "tournament_players": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tournament-player.tournament-player",
      "mappedBy": "user"
    },
    "picture": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "match_histories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::match-history.match-history",
      "mappedBy": "users"
    },
    "match_player_score": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::match-player-score.match-player-score",
      "mappedBy": "user"
    },
    "tournaments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tournament.tournament",
      "mappedBy": "user_created"
    },
    "nickname": {
      "type": "string"
    }
  }
}